[Unit]
Description=HWA one-shot drand BN254 heartbeat
Documentation=https://docs.drand.love/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hwa-drand
Group=hwa-drand
WorkingDirectory=/opt/hwa-drand
EnvironmentFile=/etc/hwa/drand-relayer.env
ExecStartPre=/usr/bin/test -x /usr/local/bin/forge
ExecStartPre=/usr/bin/test -x /usr/local/bin/cast
ExecStart=/usr/bin/node /opt/hwa-drand/.tools/drand_bn254_relayer.mjs --prove-latest
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=hwa-drand
StateDirectoryMode=0700
