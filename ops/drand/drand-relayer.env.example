# One dedicated file per host. Never reuse the deployer or Safe signer key.
HYPEREVM_CHAIN_ID=999

# Filled only after the mainnet deployment receipts are finalized.
FWA_DRAND_BN254_COORDINATOR_ADDRESS=
FWA_DRAND_REGISTRY_ADDRESS=
FWA_DRAND_DEPLOYMENT_BLOCK=
FWA_ADDRESS=

# A unique low-balance EOA generated directly on this host.
FWA_DRAND_SUBMITTER_PRIVATE_KEY=

# Use a different provider on each relayer host.
HYPEREVM_RPC_URL=
HYPEREVM_LOG_RPC_URL=
HYPEREVM_LOG_RPC_MAX_BLOCK_RANGE=1000

FWA_DRAND_FINALITY_BLOCKS=3
FWA_DRAND_POLL_INTERVAL_MS=3000
FWA_DRAND_FAIRNESS_ALERT_BLOCKS=120
FWA_DRAND_HEARTBEAT_INTERVAL_MS=180000
FWA_ACQUISITION_PROCESS_BATCH=16
FWA_DRAND_STATE_PATH=/var/lib/hwa-drand/relayer-state.json

# Optional when the log provider authenticates with a header instead of its URL.
HYPEREVM_LOG_RPC_API_KEY=
HYPEREVM_LOG_RPC_API_KEY_HEADER=x-api-key

# Linux services use Foundry from PATH by default. Override only if needed.
FOUNDRY_FORGE=forge
FOUNDRY_CAST=cast
