# Replace assets.hwa.example with the reviewed production hostname. Keep the path and
# approved collection hash unchanged. The upload root is the package's `public/` directory.
server {
    listen 443 ssl http2;
    server_name assets.hwa.example;

    root /srv/hwa-genesis/public;
    autoindex off;

    location ~ ^/hwa-genesis/v3/96b80e5c8a06b07407d92b58dbf7865aab242439bdfdb5d8436e370cd2915648/metadata/(?:[1-9]|[1-9][0-9]|[1-2][0-9]{2}|3[0-2][0-9]|33[0-3])$ {
        default_type application/json;
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    location ^~ /hwa-genesis/v3/96b80e5c8a06b07407d92b58dbf7865aab242439bdfdb5d8436e370cd2915648/images/ {
        types { image/svg+xml svg; }
        default_type application/octet-stream;
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    location = /hwa-genesis/v3/96b80e5c8a06b07407d92b58dbf7865aab242439bdfdb5d8436e370cd2915648/deployment-manifest.json {
        default_type application/json;
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }
}
