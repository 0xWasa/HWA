# Copy to .env.production.local on the VPS. Never commit the populated file.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DATA_MODE=mainnet
NEXT_PUBLIC_HYPEREVM_CHAIN_ID=999
NEXT_PUBLIC_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
NEXT_PUBLIC_HYPEREVM_LOG_RPC_URL=/api/rpc/logs
NEXT_PUBLIC_HYPEREVM_LOG_RPC_MAX_BLOCK_RANGE=
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_EXPLORER_URL=https://hyperevmscan.io
NEXT_PUBLIC_DEPLOYMENT_MANIFEST_URL=/deployments/hyperevm-mainnet-999.json

# Server-only values. Keys and credential-bearing URLs must remain here and never use NEXT_PUBLIC_.
NFT_METADATA_ALLOWED_HOSTS=assets.hwa.fun,static.drip.trade,otties.mypinata.cloud
# Safe because the production container is loopback-only and Nginx overwrites X-Real-IP.
NFT_METADATA_TRUSTED_CLIENT_IP_HEADER=x-real-ip
# The deployer wallet owns all 333 Genesis NFTs; paced frontend requests need a
# per-client allowance above a complete wallet refresh.
NFT_METADATA_RATE_LIMIT_PER_MINUTE=600

# Server-only. Powers the indicative collection floor shown during deposit.
OPENSEA_API_KEY=
NFT_IPFS_GATEWAY_BASE_URL=https://ipfs.io/ipfs/
# The browser uses the official public RPC directly. This restricted proxy is
# retained for release checks and controlled fallback traffic only.
HYPEREVM_READ_RPC_UPSTREAM_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_READ_RPC_API_KEY=
HYPEREVM_READ_RPC_API_KEY_HEADER=x-api-key
HYPEREVM_READ_RPC_CACHE_TTL_MS=1000
HYPEREVM_READ_RPC_RATE_LIMIT_PER_MINUTE=240
HYPEREVM_READ_RPC_TRUSTED_CLIENT_IP_HEADER=

HYPEREVM_LOG_RPC_PROVIDER=
HYPEREVM_LOG_RPC_UPSTREAM_URL=
HYPEREVM_LOG_RPC_API_KEY=
HYPEREVM_LOG_RPC_API_KEY_HEADER=x-api-key
HYPEREVM_LOG_RPC_ALLOWED_ADDRESSES=
HYPEREVM_LOG_RPC_MAX_BLOCK_RANGE=
HYPEREVM_LOG_RPC_RATE_LIMIT_PER_MINUTE=120
HYPEREVM_LOG_RPC_CACHE_TTL_MS=30000
HYPEREVM_LOG_RPC_TRUSTED_CLIENT_IP_HEADER=
