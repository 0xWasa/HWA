# Configuration publique uniquement. Toute variable NEXT_PUBLIC_* est livrée au navigateur.
NEXT_PUBLIC_APP_ENV=development

# mock | testnet | mainnet
NEXT_PUBLIC_DATA_MODE=testnet
NEXT_PUBLIC_HYPEREVM_CHAIN_ID=998
NEXT_PUBLIC_HYPEREVM_RPC_URL=https://rpcs.chain.link/hyperevm/testnet
# Dedicated archival/log endpoint used only if the indexer is unavailable. Production requires
# a reviewed provider supporting at least the declared range; never point this at the public RPC.
NEXT_PUBLIC_HYPEREVM_LOG_RPC_URL=
NEXT_PUBLIC_HYPEREVM_LOG_RPC_MAX_BLOCK_RANGE=0

# Vide tant que l'indexeur et l'explorer testnet ne sont pas branchés.
NEXT_PUBLIC_INDEXER_URL=
# Mainnet requires a public Goldsky subgraph endpoint here. Never put a
# deployment API key or any other secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_EXPLORER_URL=

# Manifeste livré par le frontend pour la campagne 998.
NEXT_PUBLIC_DEPLOYMENT_MANIFEST_URL=/deployments/hyperevm-testnet-998.json

# Server-only NFT metadata proxy. HTTPS tokenURI/image hosts must be explicitly
# reviewed and listed; IPFS is fetched through the configured HTTPS gateway.
# These variables are deliberately not NEXT_PUBLIC_*.
NFT_METADATA_ALLOWED_HOSTS=
NFT_METADATA_TRUSTED_CLIENT_IP_HEADER=
NFT_IPFS_GATEWAY_BASE_URL=https://ipfs.io/ipfs/

# Ne jamais placer de clé privée, mnemonic ou token serveur dans ce fichier.
