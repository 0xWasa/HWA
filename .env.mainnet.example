# HyperEVM mainnet release template (chain ID 999).
# Copy to a local ignored file. Never commit private keys or funded credentials.
PRIVATE_KEY=
OWNER_PRIVATE_KEY=
# Owner mode. Contract ownership remains supported, but the reviewed launch uses the funded
# deployer EOA only when this separately named single-key risk acknowledgement is true.
MAINNET_EOA_OWNER_CONFIRMED=false
# Historical Safe configuration retained solely to identify the abandoned deployment.
HWA_SAFE_DEPLOYMENT_CONFIRMED=false
HWA_SAFE_SIGNER_1=0x645b7e2A32cfF5e131a3D6Cf16155e006fe74F5c
HWA_SAFE_SIGNER_2=0x487F29A5C4eE0669D40d77Cd78F5b6A95046fECB
HWA_SAFE_SIGNER_3=0x10B327d693F223399F2D8151B2B97a66818FF681
HWA_SAFE_THRESHOLD=2
HWA_SAFE_PREDICTED_ADDRESS=0x75818fd0a2Ff801F974C9a5d23616fbd38b15f4C
HWA_SAFE_SALT_NONCE=86676891632942773236344265692712563299257346711408074622853684666603124754373
FWA_OWNER=0x0000000000000000000000000000000000000000

# Explicit release gates. Every value stays false through simulation and audit.
MAINNET_DEPLOYMENT_CONFIRMED=false
MAINNET_ACTIVATION_CONFIRMED=false
MAINNET_SOURCE_VERIFICATION_CONFIRMED=false
DRAND_RELAYER_REDUNDANCY_CONFIRMED=false
# Explicit temporary alternative to redundancy. This acknowledges the
# liveness/fairness risk of operating one relayer; it does not weaken the
# on-chain BN254 proof verification and must never be described as redundancy.
DRAND_SINGLE_RELAYER_RISK_ACCEPTED=false
PROJECTX_MAINNET_DEPLOYMENT_CONFIRMED=false
FWA_TOKENOMICS_CONFIRMED=false
PROJECTX_CORE_BINDING_CONFIRMED=false
PROJECTX_E2E_CONFIRMED=false
PROJECTX_PUBLIC_TRADING_CONFIRMED=false
INDEXER_DEPLOYMENT_CONFIRMED=false
PROJECTX_MARKET_PRICE_CONFIRMED=false
PROJECTX_LP_LOCK_CONFIRMED=false
# Set only after the controlled post-activation canary; it gates public manifest
# promotion, not the transaction that opens the canary window.
MAINNET_E2E_CONFIRMED=false

# Permissionless drand evmnet BN254 delivery. Gelato or another automation provider
# may relay proofs, but cannot choose the word: the signature is verified on-chain.
FWA_DRAND_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
FWA_DRAND_BN254_COORDINATOR_ADDRESS=0x0000000000000000000000000000000000000000
FWA_DRAND_DEPLOYMENT_BLOCK=
FWA_MAINNET_DEPLOYMENT_BLOCK=
FWA_DRAND_SUBMITTER_PRIVATE_KEY=
FWA_DRAND_FINALITY_BLOCKS=3
FWA_DRAND_POLL_INTERVAL_MS=3000
DRAND_PROOF_SUBMISSION_CONFIRMED=false
# Production safety buffer. The coordinator also enforces this 30-second floor on-chain.
FWA_RANDOMNESS_MIN_ROUND_DELAY_SECONDS=30
FWA_RANDOMNESS_REQUEST_EXPIRY_BLOCKS=7200
FWA_RANDOMNESS_MAX_LIVENESS_AGE_SECONDS=300
FWA_RANDOMNESS_FULFILLMENT_BOUNTY_WEI=100000000000000
FWA_RANDOMNESS_INITIAL_RESERVE_WEI=1000000000000000
FWA_MIN_RANDOMNESS_BUFFER_WEI=800000000000000
FWA_MAX_RANDOMNESS_COST_WEI=200000000000000
FWA_RANDOMNESS_GAS_ESTIMATE=800000
FWA_RANDOMNESS_MARGIN_BPS=3000
FWA_RANDOMNESS_FLAT_WEI=0
FWA_RANDOMNESS_CALLBACK_GAS_LIMIT=700000
FWA_SELECTION_TIMEOUT_BLOCKS=360

# HyperEVM-specific economic values. These are owner-adjustable, but the launch
# scripts attest the exact reviewed values before acquisitions can open.
FWA_MIN_BACKING_WEI=100000000000000000
FWA_PROTOCOL_FEE_TO_TOKEN_BPS=8000
# Buyback bounds are derived permissionlessly from the Project X 30-minute TWAP.

# FWA-style 70/30 revenue splitter. Deploy and verify this before the core.
FWA_SPLITTER_SNAPSHOT_NFT=0x0000000000000000000000000000000000000000
FWA_SPLITTER_MAX_TOKEN_ID=0
# Explicitly disabled: this sends the complete 70% owner-side allocation to FWA_OWNER.
FWA_SPLITTER_SECONDARY_OWNER=0x0000000000000000000000000000000000000000
FWA_SPLITTER_ADDRESS=0x0000000000000000000000000000000000000000
FWA_SPLITTER_DEPLOYMENT_CONFIRMED=false
FWA_SPLITTER_FREEZE_CONFIRMED=false
FWA_SPLITTER_BINDING_CONFIRMED=false

# Filled from MainnetCoreDeployed. Acquisitions remain disabled at this stage.
FWA_ADDRESS=0x0000000000000000000000000000000000000000
FWA_VRF_SERVICE_ADDRESS=0x0000000000000000000000000000000000000000
FWA_WHITELIST_ADDRESS=0x0000000000000000000000000000000000000000
FWA_COLLECTIONS=
# Exactly one reviewed collection is opened for the first live acquisition.
# Public collections require a separate RPC-attested post-canary Safe action.
FWA_CANARY_COLLECTION=0x0000000000000000000000000000000000000000
FWA_CANARY_REQUEST_ID=
FWA_PUBLIC_COLLECTIONS=
# JSON consumed by WriteMainnetManifest.ps1. Every collection must include its
# deployment block so the ownership index starts before the first ERC-721 mint.
FWA_COLLECTIONS_JSON=[]
PROJECTX_TRADE_URL=

# Optional first-party bootstrap collection. Deployment only; mint recipients,
# metadata review and the one-way snapshot freeze are separate owner actions.
HWA_GENESIS_NFT_DEPLOYMENT_CONFIRMED=false
HWA_GENESIS_NFT_FINALIZATION_CONFIRMED=false
HWA_GENESIS_NFT_MAX_SUPPLY=333
HWA_GENESIS_V3_IMAGE_CID=
HWA_GENESIS_V3_METADATA_CID=
# Primary production mode: versioned HTTPS assets on the reviewed VPS hostname.
# The IPFS values above are optional mirrors, not launch requirements.
HWA_GENESIS_V3_PUBLIC_ORIGIN=
HWA_GENESIS_V3_HOSTING_ATTESTATION_PATH=release/hwa-genesis-hosting-attestation.json
HWA_GENESIS_NFT_BASE_URI=

# Official Project X mainnet deployment, independently re-attested before launch.
PROJECTX_FACTORY=0xFf7B3e8C00e57ea31477c32A5B52a58Eea47b072
PROJECTX_ROUTER=0x1EbDFC75FfE3ba3de61E7138a3E8706aC841Af9B
PROJECTX_POSITION_MANAGER=0xeaD19AE861c29bBb2101E834922B2FEee69B9091
# These remain zero until the selected owner mode has been independently attested.
PROJECTX_WHYPE=0x5555555555555555555555555555555555555555
FWA_PROJECTX_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
HWA_ECOSYSTEM_BENEFICIARY=0x0000000000000000000000000000000000000000
# Reviewed operational ceiling across Safe deployment, protocol deployment, drand funding and
# the canary. This is not transferred into the one-sided Project X LP.
HWA_MAINNET_OPERATIONAL_BUDGET_WEI=20000000000000000000
# Deliberately blank pending explicit price approval. The current reviewed proposal is a 640 HYPE
# target inside a 600-700 HYPE band; the exact sqrt candidate depends on final HWA/wHYPE ordering.
FWA_INITIAL_SQRT_PRICE_X96=
FWA_INITIAL_SQRT_PRICE_X96_ECHO=
MAINNET_FWA_MIN_INITIAL_FDV_HYPE_WEI=
MAINNET_FWA_MAX_INITIAL_FDV_HYPE_WEI=
FWA_LP_RANGE_WIDTH_TICKS=3600

# Filled progressively by the Project X launch phases.
FWA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
FWA_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000
FWA_PROJECTX_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
FWA_PROJECTX_POOL_ADDRESS=0x0000000000000000000000000000000000000000
FWA_PROJECTX_LIQUIDITY_LOCKER_ADDRESS=0x0000000000000000000000000000000000000000
HWA_ECOSYSTEM_VESTING_ADDRESS=0x0000000000000000000000000000000000000000

# Frontend/indexer production values are configured in frontend/.env.production.local.
NEXT_PUBLIC_DATA_MODE=mainnet
NEXT_PUBLIC_HYPEREVM_CHAIN_ID=999
NEXT_PUBLIC_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
# Required independent emergency path. The browser only calls the same-origin restricted proxy;
# the provider URL/key remain server-only. Populate the reviewed range from TestLogRpc.ps1.
NEXT_PUBLIC_HYPEREVM_LOG_RPC_URL=/api/rpc/logs
NEXT_PUBLIC_HYPEREVM_LOG_RPC_MAX_BLOCK_RANGE=
NEXT_PUBLIC_DEPLOYMENT_MANIFEST_URL=/deployments/hyperevm-mainnet-999.json
# Public Goldsky subgraph query endpoint, never the deployment API key.
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_EXPLORER_URL=https://hyperevmscan.io

# Server-only metadata proxy policy. Include every reviewed HTTPS metadata/CDN
# hostname used by the allowlisted collections; comma-separated, exact hosts.
NFT_METADATA_ALLOWED_HOSTS=assets.hwa.fun,static.drip.trade,otties.mypinata.cloud
NFT_METADATA_TRUSTED_CLIENT_IP_HEADER=x-real-ip
NFT_METADATA_RATE_LIMIT_PER_MINUTE=600
NFT_IPFS_GATEWAY_BASE_URL=https://ipfs.io/ipfs/

# Local CLI credential used only to deploy the compiled subgraph. Never expose
# this value as NEXT_PUBLIC_* and never commit the populated file.
GOLDSKY_API_KEY=
GOLDSKY_SUBGRAPH_VERSION=1.0.0
GOLDSKY_MAINNET_PUBLISH_CONFIRMED=false

# Server-only archive/log provider. Preferred candidate: HyperliquidRPC; QuickNode nanoreth or
# Chainstack archive are acceptable only after the same probe passes. Never prefix these with NEXT_PUBLIC_.
HYPEREVM_LOG_RPC_PROVIDER=
HYPEREVM_LOG_RPC_UPSTREAM_URL=
# Secretless release-gate mode for an upstream already installed on the VPS.
# Values must match the reviewed log-rpc attestation exactly; the public probe
# proves that the bounded production route is serving the deployed FWA address.
HYPEREVM_LOG_RPC_RUNTIME_ATTESTED=false
HYPEREVM_LOG_RPC_UPSTREAM_HOST=
HYPEREVM_LOG_RPC_UPSTREAM_FINGERPRINT_SHA256=
HYPEREVM_LOG_RPC_PUBLIC_PROBE_URL=https://hwa.fun/api/rpc/logs
HYPEREVM_LOG_RPC_API_KEY=
HYPEREVM_LOG_RPC_API_KEY_HEADER=x-api-key
HYPEREVM_LOG_RPC_ALLOWED_ADDRESSES=
HYPEREVM_LOG_RPC_MAX_BLOCK_RANGE=
HYPEREVM_LOG_RPC_RATE_LIMIT_PER_MINUTE=120
HYPEREVM_LOG_RPC_ATTESTATION_PATH=release/log-rpc-probe-999.json
# Set only to a header guaranteed to be overwritten by the hosting edge (for example Vercel's
# x-vercel-forwarded-for). Leave blank when that trust boundary is not documented.
HYPEREVM_LOG_RPC_TRUSTED_CLIENT_IP_HEADER=
