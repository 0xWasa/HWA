# Never commit a funded private key. Copy this file to .env locally.
PRIVATE_KEY=
FWA_OWNER=0x0000000000000000000000000000000000000000

# HyperEVM 998-only actors and deployable NFT fixtures. Public actor addresses
# may temporarily point to the deployer for smoke tests, but must be distinct
# before the multi-wallet E2E matrix.
FWA_TEST_DEPOSITOR=0x0000000000000000000000000000000000000000
FWA_TEST_PURCHASER=0x0000000000000000000000000000000000000000
FWA_TEST_SNAPSHOT_HOLDER=0x0000000000000000000000000000000000000000
# Test-only keys for live multi-signer E2E. Never reuse mainnet wallets and
# never commit, print or paste these values into chat.
FWA_TEST_DEPOSITOR_PRIVATE_KEY=
FWA_TEST_PURCHASER_PRIVATE_KEY=
FWA_TEST_SNAPSHOT_HOLDER_PRIVATE_KEY=
FWA_TESTNFT_DEPLOYMENT_CONFIRMED=false
FWA_TEST_SNAPSHOT_NFT=0x0000000000000000000000000000000000000000
FWA_TEST_GAMEPLAY_NFT=0x0000000000000000000000000000000000000000
FWA_TEST_HOSTILE_NFT=0x0000000000000000000000000000000000000000

# Phase 1 deployment parameters. Values remain deliberately tiny until the
# Proof of Play fee/relay model is measured on HyperEVM testnet.
FWA_MIN_RANDOMNESS_BUFFER_WEI=1
FWA_MAX_RANDOMNESS_COST_WEI=1
FWA_RANDOMNESS_GAS_ESTIMATE=800000
FWA_RANDOMNESS_MARGIN_BPS=3000
FWA_RANDOMNESS_FLAT_WEI=0
# Production-compatible drand evmnet BN254 verifier. Testnet v2 uses the same
# on-chain BLS verification path; only economic buffers differ.
FWA_DRAND_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
FWA_DRAND_BN254_COORDINATOR_ADDRESS=0x0000000000000000000000000000000000000000
FWA_RANDOMNESS_MIN_ROUND_DELAY_SECONDS=30
FWA_RANDOMNESS_REQUEST_EXPIRY_BLOCKS=7200
FWA_RANDOMNESS_MAX_LIVENESS_AGE_SECONDS=900
FWA_RANDOMNESS_FULFILLMENT_BOUNTY_WEI=1

# FWA-parity revenue splitter. The snapshot collection must expose ownerOf,
# getCurrentSupply and burnedTokenCount. Its state is frozen into the splitter
# constructor; the Ethereum collection address must not be reused on HyperEVM.
FWA_SPLITTER_SNAPSHOT_NFT=0x0000000000000000000000000000000000000000
FWA_SPLITTER_MAX_TOKEN_ID=324
FWA_SPLITTER_SECONDARY_OWNER=0x0000000000000000000000000000000000000000
FWA_SPLITTER_ADDRESS=0x0000000000000000000000000000000000000000
FWA_SPLITTER_DEPLOYMENT_CONFIRMED=false
FWA_SPLITTER_BINDING_CONFIRMED=false

# Filled from the CoreDeployed event after phase 1.
FWA_ADDRESS=0x0000000000000000000000000000000000000000
FWA_VRF_SERVICE_ADDRESS=0x0000000000000000000000000000000000000000
FWA_RANDOMNESS_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
FWA_WHITELIST_ADDRESS=0x0000000000000000000000000000000000000000
FWA_CORE_RESUME_CONFIRMED=false

# HyperEVM 998 drand-relay coordinator. This is an explicitly offchain-verified
# testnet bridge: two independent public drand endpoints must agree before the
# authorized relayer submits the signature. Activation stays separately gated.
FWA_DRAND_RELAYER=0x0000000000000000000000000000000000000000
FWA_DRAND_RELAYER_PRIVATE_KEY=
FWA_DRAND_COORDINATOR_ADDRESS=0x0000000000000000000000000000000000000000
FWA_DRAND_DEPLOYMENT_BLOCK=0
FWA_DRAND_MIN_ROUND_DELAY_SECONDS=6
FWA_DRAND_FINALITY_BLOCKS=2
FWA_DRAND_POLL_INTERVAL_MS=3000
FWA_DRAND_DEPLOYMENT_CONFIRMED=false
FWA_DRAND_ACTIVATION_CONFIRMED=false
# FWA does not expose this internal flag; restoration must therefore be explicit.
FWA_DRAND_RESTORE_ACQUISITIONS=false
FWA_DRAND_GAMEPLAY_PREPARE_CONFIRMED=false
FWA_DRAND_GAMEPLAY_SETTLE_CONFIRMED=false
FWA_DRAND_GAMEPLAY_RETRY_CONFIRMED=false
FWA_DRAND_GAMEPLAY_TOKEN_ID=1
FWA_DRAND_GAMEPLAY_BACKING_WEI=10000000000000000
FWA_DRAND_ACTOR_TARGET_BALANCE_WEI=30000000000000000
FWA_DRAND_E2E_GAS_PRICE_WEI=100000000
FWA_DRAND_E2E_FEE_QUOTE_GAS_PRICE_WEI=300000000
FWA_DRAND_SELECTION_TIMEOUT_BLOCKS=360
FWA_DRAND_GAMEPLAY_LISTING_ID=0
FWA_DRAND_GAMEPLAY_REQUEST_ID=0

# Comma-separated, reviewed HyperEVM ERC-721 addresses.
FWA_COLLECTIONS=

# Must only be set after Proof of Play confirms manual registration of the
# deployed adapter address.
POP_REGISTRATION_CONFIRMED=false

# Project X V3 token/rewards deployment. Chain 998 uses the official HyperSwap
# V3 contracts only as an ABI-compatible test venue; Project X has no official
# chain-998 deployment. The 20% recipient is always explicit.
FWA_TESTNET_V2_CORE_DEPLOYMENT_CONFIRMED=false
FWA_TESTNET_V2_ACTIVATION_CONFIRMED=false
PROJECTX_MODULES_RESUME_CONFIRMED=false
FWA_TOKENOMICS_CONFIRMED=false
FWA_LEGACY_ALLOCATION_RECIPIENT=0x0000000000000000000000000000000000000000
FWA_PROJECTX_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
FWA_INITIAL_SQRT_PRICE_X96=79228162514264337593543950336
FWA_LP_RANGE_WIDTH_TICKS=3600
# Legacy Nest-only setting. The active Project X token derives its buyback
# minOut and price limit on-chain from the 30-minute pool TWAP/current spot.
FWA_BUYBACK_MIN_OUT_PER_HYPE_X96=

# Filled from ProjectXTokenPrepared / ProjectXModulesPrepared.
FWA_TOKEN_LAUNCH_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
FWA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
FWA_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000
FWA_PROJECTX_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
FWA_PROJECTX_POOL_ADDRESS=0x0000000000000000000000000000000000000000
FWA_PROJECTX_LIQUIDITY_LOCKER_ADDRESS=0x0000000000000000000000000000000000000000

# Explicit action gates. Keep false during dry-runs. Public buys are opened and
# closed manually; no timer can change the state.
PROJECTX_MAINNET_DEPLOYMENT_CONFIRMED=false
PROJECTX_CORE_BINDING_CONFIRMED=false
PROJECTX_MODULES_RESUME_CONFIRMED=false
PROJECTX_TESTNET_COLLECTION_CONFIRMED=false
PROJECTX_E2E_CONFIRMED=false
PROJECTX_PUBLIC_TRADING_CONFIRMED=false
FWA_TESTNET_GAMEPLAY_COLLECTION=0x0000000000000000000000000000000000000000
FWA_SPLITTER_TEST_CONFIRMED=false
FWA_SPLITTER_TEST_WEI=1000000000000000
